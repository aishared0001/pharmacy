# Copy this file to .env and fill in your Supabase project values.
# Get these from your Supabase project: Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The values below are NOT used by the mobile app. They are the secrets the
# `send-order-email` Supabase Edge Function needs. Set them with the Supabase
# CLI (see README), never commit real values:
#
#   supabase secrets set GMAIL_USER=aishared0001@gmail.com
#   supabase secrets set GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"  # Google App Password
#   supabase secrets set OWNER_EMAIL=aishared0001@gmail.com        # where order alerts go
#
# GMAIL_APP_PASSWORD is a 16-character Google "App Password" (needs 2-Step
# Verification turned on), NOT your normal Gmail password. Spaces are ignored.
# Until these are set the function still runs and logs the composed email
# payload instead of sending it.
# ---------------------------------------------------------------------------
