# Copy this file to .env and fill in your Supabase project values.
# Get these from your Supabase project: Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The values below are NOT used by the mobile app. They are the secrets the
# `send-order-email` Supabase Edge Function needs. Set them with the Supabase
# CLI (see README), never commit real values:
#
#   supabase secrets set OWNER_EMAIL=aishared0001@gmail.com
#   supabase secrets set FROM_EMAIL="MediGo <orders@yourdomain.com>"
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx        # if using Resend
#
# Until these are set the function still runs and logs the composed email
# payload instead of sending it.
# ---------------------------------------------------------------------------
